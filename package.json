{
  "name": "scroll-progress",
  "private": true,
  "description": "Chrome extension showing the scroll progress of the current page.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "syntax": "find extension -name \"*.js\" -print0 | xargs -0 -n 1 sh -c 'node --check < \"$0\"'",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build:zip": "sh scripts/build-zip.sh",
    "package:zip": "npm run build:zip",
    "clean": "rm -f extension.zip",
    "verify": "npm run syntax && npm run typecheck && npm run test && npm run build:zip"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  }
}
