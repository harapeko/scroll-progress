{
  "manifest_version": 3,
  "name": "Scroll Progress",
  "version": "1.1.0",
  "description": "Shows the scroll progress of current page.",
  "action": {
    "default_title": "Toggle Scroll Progress"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon@16px.png",
    "48": "icons/icon@48px.png",
    "128": "icons/icon@128px.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["./core.js", "./indicator.js", "./content.js"]
    }
  ]
}
